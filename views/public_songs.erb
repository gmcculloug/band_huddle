<% if @band.logo_filename.present? || @band.show_band_name %>
    <div class="band-header">
        <% if @band.logo_filename.present? %>
            <img src="/uploads/band_logos/<%= @band.logo_filename %>"
                 alt="<%= h(@band.name) %>"
                 fetchpriority="high">
        <% end %>
        <% if @band.show_band_name || !@band.logo_filename.present? %>
            <div class="band-title"><%= h(@band.name) %></div>
        <% end %>
    </div>
<% end %>

<h1 class="page-heading" data-vote-counts-url="/band/<%= h(@band.slug) %>/songs/vote_counts">Songs</h1>

<% if @band.public_schedule_enabled? %>
    <div class="cross-page-nav">
        <a href="/band/<%= @band.slug %>">📅 View Upcoming Shows</a>
    </div>
<% end %>

<div class="view-toggle">
    <a href="/band/<%= @band.slug %>/songs?by=title" class="view-toggle-link<%= ' active' if @view_by == 'title' %>">By Title</a>
    <a href="/band/<%= @band.slug %>/songs?by=artist" class="view-toggle-link<%= ' active' if @view_by == 'artist' %>">By Artist</a>
    <a href="/band/<%= @band.slug %>/songs?by=votes" class="view-toggle-link<%= ' active' if @view_by == 'votes' %>">By Votes</a>
</div>

<% if params[:success] %>
    <div class="success-banner"><%= h(params[:success]) %></div>
<% elsif params[:error] %>
    <div class="error-banner"><%= h(params[:error]) %></div>
<% end %>

<details class="recommend-song">
    <summary>🎤 Recommend a Song</summary>
    <% if @recommend_errors %>
        <ul class="error-list">
            <% @recommend_errors.each do |msg| %><li><%= h(msg) %></li><% end %>
        </ul>
    <% end %>
    <form method="post" action="/band/<%= @band.slug %>/songs/recommend">
        <input type="text" name="website" value="" style="position:absolute;left:-9999px;top:-9999px" tabindex="-1" autocomplete="off">
        <label>Song Title <input type="text" name="title" maxlength="200" required></label>
        <label>Artist <input type="text" name="artist" maxlength="200" required></label>
        <label>Notes (optional) <textarea name="notes" maxlength="500"></textarea></label>
        <button type="submit" class="btn btn-primary">Submit Recommendation</button>
    </form>
</details>

<% if @songs.any? %>
    <% if @view_by == 'votes' %>
        <div class="song-card song-card--votes">
            <% @songs.each do |song| %>
                <div class="song-row" data-song-id="<%= song.id %>" data-song-title="<%= h(song.title) %>">
                    <div class="song-title"><%= h(song.title) %></div>
                    <div class="song-artist"><%= h(song.artist) %></div>
                    <%
                        _voted = @voted_song_ids.include?(song.id)
                        _action = _voted ? 'downvote' : 'upvote'
                    %>
                    <form method="post" action="/band/<%= @band.slug %>/songs/<%= song.id %>/<%= _action %>?by=<%= @view_by %>" class="vote-form">
                        <button type="submit" class="vote-btn" aria-label="<%= _voted ? 'Remove vote for' : 'Upvote' %> <%= h(song.title) %>"><%= _voted ? '✘' : '▲' %></button>
                        <span class="vote-count<%= ' vote-count--voted' if _voted %><%= ' vote-count--flash' if params[:voted].to_s == song.id.to_s %>"><%= song.votes_count %></span>
                    </form>
                </div>
            <% end %>
        </div>
    <% else %>
        <%
          _group_field = @view_by == 'artist' ? :artist : :title
          _letter_groups = @songs.group_by { |song| song.public_send(_group_field)[0].upcase }

          _palette = [
            { bg: '#c44d7a' },
            { bg: '#c97030' },
            { bg: '#6848c0' },
            { bg: '#2a9e8a' },
            { bg: '#b89020' },
          ]
          _last = nil
          _letter_colors = _letter_groups.keys.each_with_object({}) do |letter, colors|
            _last = (_palette - [_last]).sample
            colors[letter] = _last
          end
        %>
        <% _letter_groups.each do |letter, songs| %>
            <div class="letter-row">
                <div class="song-badge" style="background:<%= _letter_colors[letter][:bg] %>"><%= h(letter) %></div>
                <div class="song-card">
                    <% songs.each do |song| %>
                        <div class="song-row" data-song-id="<%= song.id %>" data-song-title="<%= h(song.title) %>">
                            <% if @view_by == 'artist' %>
                                <div class="song-title"><%= h(song.artist) %></div>
                                <div class="song-artist"><%= h(song.title) %></div>
                            <% else %>
                                <div class="song-title"><%= h(song.title) %></div>
                                <div class="song-artist"><%= h(song.artist) %></div>
                            <% end %>
                            <%
                                _voted = @voted_song_ids.include?(song.id)
                                _action = _voted ? 'downvote' : 'upvote'
                            %>
                            <form method="post" action="/band/<%= @band.slug %>/songs/<%= song.id %>/<%= _action %>?by=<%= @view_by %>" class="vote-form">
                                <button type="submit" class="vote-btn" aria-label="<%= _voted ? 'Remove vote for' : 'Upvote' %> <%= h(song.title) %>"><%= _voted ? '✘' : '▲' %></button>
                                <span class="vote-count<%= ' vote-count--voted' if _voted %><%= ' vote-count--flash' if params[:voted].to_s == song.id.to_s %>"><%= song.votes_count %></span>
                            </form>
                        </div>
                    <% end %>
                </div>
            </div>
        <% end %>
    <% end %>
<% else %>
    <div class="no-gigs">
        <div class="no-gigs-icon">🎵</div>
        <p>No songs to show yet.</p>
        <p style="font-size: 0.9rem; margin-top: 10px;">Check back soon for updates!</p>
    </div>
<% end %>

<% if @songs.any? %>
    <script>
        (function() {
            var heading = document.querySelector('.page-heading');
            var votesUrl = heading && heading.dataset.voteCountsUrl;
            var isFetching = false;
            if (!votesUrl) return;

            function updateVoteRow(row, vote) {
                var count = row.querySelector('.vote-count');
                var form = row.querySelector('.vote-form');
                var button = form && form.querySelector('.vote-btn');
                if (count) {
                    count.textContent = vote.votes_count;
                    count.classList.remove('vote-count--flash');
                    void count.offsetWidth;
                    count.classList.add('vote-count--flash');
                    count.classList.toggle('vote-count--voted', vote.voted);
                }
                if (form) {
                    var action = vote.voted ? 'downvote' : 'upvote';
                    form.action = form.action.replace(/\/(upvote|downvote)(?=\?|$)/, '/' + action);
                }
                if (button) {
                    button.textContent = vote.voted ? '✘' : '▲';
                    button.setAttribute('aria-label', (vote.voted ? 'Remove vote for ' : 'Upvote ') + row.dataset.songTitle);
                }
            }

            function sortVotesCard() {
                var votesCard = document.querySelector('.song-card--votes');
                if (!votesCard) return;
                var rows = Array.prototype.slice.call(votesCard.children);
                var sortedRows = rows.slice().sort(function(a, b) {
                    var countA = Number(a.querySelector('.vote-count').textContent) || 0;
                    var countB = Number(b.querySelector('.vote-count').textContent) || 0;
                    var titleA = a.querySelector('.song-title').textContent.toLocaleLowerCase();
                    var titleB = b.querySelector('.song-title').textContent.toLocaleLowerCase();
                    return countB - countA || titleA.localeCompare(titleB);
                });
                if (sortedRows.some(function(row, index) { return row !== rows[index]; })) {
                    sortedRows.forEach(function(row) { votesCard.appendChild(row); });
                }
            }

            async function refreshVoteCounts() {
                if (document.hidden || isFetching) return;
                isFetching = true;

                try {
                    var response = await fetch(votesUrl, {
                        headers: { 'Accept': 'application/json' },
                        cache: 'no-store'
                    });
                    if (!response.ok) return;

                    var payload = await response.json();
                    payload.votes.forEach(function(vote) {
                        var row = document.querySelector('.song-row[data-song-id="' + vote.id + '"]');
                        if (!row) return;

                        var count = row.querySelector('.vote-count');
                        var form = row.querySelector('.vote-form');
                        var button = form && form.querySelector('.vote-btn');
                        if (count) {
                            count.textContent = vote.votes_count;
                            count.classList.toggle('vote-count--voted', vote.voted);
                        }
                        if (form) {
                            var action = vote.voted ? 'downvote' : 'upvote';
                            form.action = form.action.replace(/\/(upvote|downvote)(?=\?|$)/, '/' + action);
                        }
                        if (button) {
                            button.textContent = vote.voted ? '✘' : '▲';
                            button.setAttribute('aria-label', (vote.voted ? 'Remove vote for ' : 'Upvote ') + row.dataset.songTitle);
                        }
                    });

                    sortVotesCard();
                } catch (error) {
                    // Polling is best-effort; keep the last displayed counts on failure.
                } finally {
                    isFetching = false;
                }
            }

            var feedback = document.createElement('div');
            feedback.className = 'error-banner';
            feedback.setAttribute('role', 'alert');
            feedback.hidden = true;
            heading.insertAdjacentElement('afterend', feedback);

            document.addEventListener('submit', async function(event) {
                var form = event.target.closest('.vote-form');
                if (!form) return;
                event.preventDefault();

                var button = form.querySelector('.vote-btn');
                if (button) button.disabled = true;
                feedback.hidden = true;

                try {
                    var response = await fetch(form.action, {
                        method: 'POST',
                        headers: { 'Accept': 'application/json' },
                        cache: 'no-store'
                    });
                    var payload = await response.json();
                    if (!response.ok || !payload.success) {
                        feedback.textContent = payload.error || 'Unable to update your vote. Please try again.';
                        feedback.hidden = false;
                        return;
                    }

                    var row = form.closest('.song-row');
                    if (row) updateVoteRow(row, payload.vote);
                    sortVotesCard();
                    refreshVoteCounts();
                } catch (error) {
                    feedback.textContent = 'Unable to update your vote. Please try again.';
                    feedback.hidden = false;
                } finally {
                    if (button) button.disabled = false;
                }
            });

            window.setInterval(refreshVoteCounts, 5000);
        })();
    </script>
<% end %>
